  "dlc3_herald_antifighter_frigate_description": "{color:highlighted_value}Nokta Savunma Firkateyni{color:/}{color:positive_value}\\n+ Füzeleri ve Saldırı Gemilerini Hedefler{color:/}\\n\\nDüşman füzelerini ve saldırı gemilerini alt etmek için tasarlanmış, çok sayıda hızlı ateşleyen nokta savunma silahıyla donatılmış hafif bir firkateyn.",
  "dlc3_herald_antifighter_frigate_name": "Azgerin Bastırıcısı",
  "dlc3_herald_attack_corvette_description": "{color:highlighted_value}Muharebe Korveti{color:/}{color:positive_value}\\n+ Kaçamak Saldırı Düzeni{color:/}\\n\\nDüşük dayanıklılıktaki hedefleri yok etmek üzere donatılmış küçük bir saldırı korveti. Saldırı sırasında yapılan otomatik kaçınma manevraları, bazı silahların bu birimi etkili biçimde hedeflemesini engeller.",
  "dlc3_herald_attack_corvette_name": "Azithel Zerresi",
  "dlc3_herald_carrier_cruiser_description": "{color:highlighted_value}Taşıyıcı Kruvazör{color:/}{color:positive_value}\\n+ Esnek Saldırı Gemisi Donanımı{color:/}\\n\\nAmalgam saldırı gemileri üretip desteklemek üzere donatılmış kırılgan bir kruvazör.",
  "dlc3_herald_carrier_cruiser_name": "Akeniel Hayaleti",
  "dlc3_herald_cloak_frigate_description": "{color:highlighted_value}Hafif Firkateyn{color:/}{color:positive_value}\\n+ Gizlenebilir{color:/}\\n\\nGizlenme cihazına sahip hızlı bir firkateyn; destek gemilerini yok etmekte veya yapıları taciz etmekte etkilidir.",
  "dlc3_herald_cloak_frigate_name": "Kaziel Gölgesi",
  "dlc3_herald_colony_frigate_description": "{color:highlighted_value}Koloni Firkateyni{color:/}{color:positive_value}\\n+ Gezegenleri Kolonize Eder{color:/}\\n\\nSahipsiz gezegenleri kolonize edebilen büyük bir firkateyn. Sınırlı saldırı silahları sayesinde düşük dayanıklılıktaki hedeflere karşı savaşa katkı sunabilir.",
  "dlc3_herald_colony_frigate_name": "Ithasaz İstilacısı",
  "dlc3_herald_constructor_ship_description": "Çok sayıda montaj aracıyla donatılmış bir hizmet firkateyni; gezegenin menzili içinde yapılar inşa eder.",
  "dlc3_herald_constructor_ship_name": "Athezil Yaratıcısı",
  "dlc3_herald_corruptor_cruiser_description": "{color:highlighted_value}Yozlaşma Destek Kruvazörü{color:/}{color:positive_value}\\n+ Yozlaşma Yönetim Yetenekleri{color:/}\\n\\nKaranlık bir deponun çevresine inşa edilmiş bir destek kruvazörü olan Anzarien Yozlaştırıcısı, muharebe sırasında Eidolon gemilerinin yozlaşma seviyelerini hızla artırabilir veya yönetebilir.",
  "dlc3_herald_corruptor_cruiser_name": "Anzarien Yozlaştırıcısı",
  "dlc3_herald_defiler_cruiser_description": "{color:highlighted_value}Bozucu Destek Kruvazörü{color:/}{color:positive_value}\\n+ Zırh Destek Yetenekleri{color:/}\\n\\nZırhı bozabilen veya onarabilen, ağır korumalı bir destek kruvazörü olan Nalazhin Kirleticisi, aynı zamanda etkili bir ön hat muharebe birimi olarak da görev yapabilir.",
  "dlc3_herald_defiler_cruiser_name": "Nalazhin Kirleticisi",
  "dlc3_herald_heavy_frigate_description": "{color:highlighted_value}Ağır Firkateyn{color:/}{color:positive_value}\\n+ Çok Yönlü Silah{color:/}\\n\\nDüşük dayanıklılıktaki firkateyn ve korvetlere karşı etkili, sağlam bir muharebe firkateyni.",
  "dlc3_herald_heavy_frigate_name": "Nethril Kabuğu",
  "dlc3_herald_long_range_cruiser_description": "{color:highlighted_value}Ateş Destek Kruvazörü{color:/}{color:positive_value}\\n+ Uzun Menzilli Silah{color:/}\\n\\nAna gemileri ve yapıları yok etmekte üstün, uzun menzilli bir silahla donatılmış ileri bir muharebe gemisi.",
  "dlc3_herald_long_range_cruiser_name": "Israthil Susturucusu",
  "dlc3_herald_missile_frigate_description": "{color:highlighted_value}Füze Firkateyni{color:/}{color:positive_value}\\n+ Yüksek Hasarlı Silah{color:/}\\n\\nAğır kruvazörleri ve ana gemileri yok etmek için Boşluk Füzelerine dayanan uzun menzilli bir muharebe firkateyni.",
  "dlc3_herald_missile_frigate_name": "Sythren Saldırısı",
  "dlc3_herald_scout_corvette_description": "{color:highlighted_value}Keşif Korveti{color:/}{color:positive_value}\\n+ Otomatik Keşfeder{color:/}\\n\\nİleri motorlara ve savunmalara sahip, düşman topraklarında keşif için en iyi duruma getirilmiş hafif bir korvet.",
  "dlc3_herald_scout_corvette_name": "Ithren Uyuyanı",
  "dlc3_herald_siege_cruiser_description": "{color:highlighted_value}Kuşatma Kruvazörü{color:/}{color:positive_value}\\n+ Gezegenleri Bombardıman Eder{color:/}\\n\\nDoğrudan çarpışmada çeşitli hedeflerle savaşabilen, aynı zamanda gezegenleri bombardıman edebilen çok yönlü bir saldırı gemisi.",
  "dlc3_herald_siege_cruiser_name": "Sirathaz Afeti",
  "dlc3_herald_battle_capital_ship_description": "{color:highlighted_value}Muharebe Ana Gemisi{color:/}{color:positive_value}\\n+ Yüksek Hasarlı Silahlar\\n+ Savunma Destek Yetenekleri{color:/}\\n\\nDoğrudan çarpışmaya girmek ve kendisine ya da dost kuvvetlere kalkan puanı yenilemek üzere donatılmış ölümcül bir savaş gemisi.",
  "dlc3_herald_battle_capital_ship_name": "Thalkerin Hortlağı",
  "dlc3_herald_carrier_capital_ship_description": "{color:highlighted_value}Taşıyıcı Ana Gemi{color:/}{color:positive_value}\\n+ Esnek Saldırı Gemisi Donanımı\\n+ Taşıyıcı Destek Yetenekleri{color:/}\\n\\nÇok sayıda güçlü Amalgam saldırı gemisini ve onları destekleyen sistemleri taşıyan büyük bir savaş gemisi.",
  "dlc3_herald_carrier_capital_ship_name": "Lakhaziel Arkonu",
  "dlc3_herald_colony_capital_ship_description": "{color:highlighted_value}Koloni Ana Gemisi{color:/}{color:positive_value}\\n+ Gezegenleri Kolonize Eder\\n+ Yozlaşma Destek Yetenekleri{color:/}\\n\\nYozlaşmayı gezegenlere ve gemilere yayabilen güçlü bir destek gemisi; ayrıca gezegenleri kolonize edebilir.",
  "dlc3_herald_colony_capital_ship_name": "Izharien Demiurgosu",
  "dlc3_herald_siege_capital_ship_description": "{color:highlighted_value}Kuşatma Ana Gemisi{color:/}{color:positive_value}\\n+ Uzun Menzilli Silahlar\\n+ Saldırı Destek Yetenekleri{color:/}\\n\\nTek ve büyük hedefleri yok etmekte olduğu kadar gezegenleri bombardıman etmekte de üstün, uzun menzilli bir savaş gemisi.",
  "dlc3_herald_siege_capital_ship_name": "Sazhirel Yok Edicisi",
  "dlc3_herald_support_capital_ship_description": "{color:highlighted_value}Destek Ana Gemisi{color:/}{color:positive_value}\\n+ Gizlenebilir\\n+ Bozucu Destek Yetenekleri{color:/}\\n\\nDüşman kuvvetleri arasında kaos yayan ve gizlenerek görünmeden hareket edebilen sinsi bir savaş gemisi.",
  "dlc3_herald_support_capital_ship_name": "Kalizaeth Saygısızı",
  "dlc3_herald_super_capital_ship_description": "{color:highlighted_value}Komuta Gemisi{color:/}",
