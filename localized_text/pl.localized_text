  "advent_laser_defense_kinetic_blast_ability_description": "Skupia energię psioniczną w jednym punkcie przestrzeni, generując wybuch, który uszkadza wszystkie pobliskie wrogie jednostki, w tym pociski i myśliwce szturmowe.",
  "trader_gauss_defense_meson_bolt_ability_name": "Pocisk mezonowy",
  "trader_gauss_defense_meson_bolt_ability_description": "Wystrzel w cel wiązkę wysokoenergetycznych cząstek, zadając obrażenia i osłabiając wytrzymałość pancerza.",
  "advent_beam_defense_synergetic_ward_ability_name": "Synergiczna osłona",
  "advent_beam_defense_synergetic_ward_ability_description": "Wzmacnia tarcze i moc psi pobliskich struktur i stacji kosmicznych.",
