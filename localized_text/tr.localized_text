  "player_ai_alliance_offer_decline_reason.out_of_patience": "Şu an senden haber almaktan bıktık.",
  "player_ai_alliance_offer_decline_reason.trade_is_not_reasonable": "Bu takas bizim için makul değil.",
  "player_ai_advent_alliance.1": "Birlik, ortak amacımızda güç olduğunu gösteriyor. Bir ittifak öneriyorum.",
  "player_ai_advent_alliance.2": "Sana bir ittifak teklif ediyorum. Birlikte bu kaotik sektöre uyum getirebiliriz.",
  "player_ai_advent_alliance.3": "Görüşlerimizin çatışması şart değil. Bana katıl, bu dünyaları birlikte aydınlatalım.",
  "player_ai_advent_loyalist_taunt.1": "Hiç kimse intikamın yoluna çıkamaz. Hele senin kadar zavallı biri asla.",
  "player_ai_advent_rebel_taunt.1": "Yozlaşmanın pek çok biçimi vardır. Bazıları sinsidir... Seninki değil.",
  "player_ai_advent_rebel_taunt.2": "Birliği yozlaşmadan arındırmak da seni yok etmek kadar kolay olsaydı.",
  "player_ai_advent_rebel_taunt.3": "Ölümde güç vardır ama senin ölümün fark bile edilmezdi.",
  "player_ai_advent_rebel_taunt.4": "Çoğu ruh bakmaya değer güzelliktedir. Seninki ise tüm imparatorluğuna düşmüş bir gölge.",
  "player_ai_advent_taunt.1": "Seninki gibi bir zihnin katılması Birliğe doğrudan zarar verirdi.",
  "player_ai_advent_taunt.10": "Düşüncelerin bir sonraki hamleni gemilerinden önce ele veriyor. Neredeyse haksızlık. Neredeyse.",
  "player_ai_advent_taunt.2": "Müritlerim korkuyu, şüpheyi ve ölümü aştı. Sen de yeterliliği aştın.",
  "player_ai_advent_taunt.3": "Düşüncelerini Birlik aracılığıyla gördüm. Keşke görmeseydim. Hayal kırıklığı.",
  "player_ai_advent_taunt.4": "Ben dünyaları barış ve aydınlanmayla kendi tarafıma çektim. Sen? Sen şiddetle bile fethedemiyorsun. Utanç verici.",
  "player_ai_advent_taunt.5": "Düşüncelerini okumadan önce bile taktiklerin apaçıktı. Okuduktan sonra mı? Düpedüz acıklı.",
  "player_ai_advent_taunt.6": "Ticaret Düzeni bizi inançlarımız yüzünden sürgün etti. Senin bu kadar beceriksiz olmanın bahanesi ne?",
  "player_ai_advent_taunt.7": "Aydınlanmanın yolu zorludur. Seni yenmenin yolu mu? Hakaret sayılacak kadar kolay.",
  "player_ai_advent_taunt.8": "İlginç. Birlik bana bu savaşı kazanabileceğin bir düzine yol gösterdi. Hiçbirini bulamadın.",
  "player_ai_advent_taunt.9": "Aşkınlığın yolu disiplin, odak ve öngörü ister. Senin yaklaşımınsa... yeniden düşünmeyi.",
  "player_ai_tec_taunt.1": "Keşifçilerim filo yapını rapor etti. Kendi gözlerimle görene kadar şaka sandım.",
  "player_ai_tec_taunt.2": "Senin türünün bugüne dek kolonize ettiğinden daha fazla dünyayı cama çevirdim. Haddini bil.",
  "player_ai_tec_taunt.3": "Senin amiralliğinden daha iyi taktik anlayışı olan şirket güvenlik birimleri gördüm.",
  "player_ai_tec_taunt.4": "Ticaret yollarım tüm imparatorluğunu satın almaya yetecek gelir sağlıyor. Hem de iki kez.",
  "player_ai_tec_taunt.5": "Vasari'yle ilk temastan sağ çıktım. Sen bundan sağ çıkamayacaksın.",
  "player_ai_tec_taunt.6": "Sen buna savunma hattı mı diyorsun? Tüm muharebe grubundan daha tehditkâr sevkiyat gecikmeleri yaşadım.",
  "player_ai_tec_taunt.7": "İkmal subaylarım, senin 'tehdidine' mühimmat harcamak zorunda kaldıkları için resmi şikâyet dilekçesi yazıyor.",
  "player_ai_tec_taunt.8": "Son dakika: Yerel milis kendini rezil etti, ayrıntılar ana haber bülteninde.",
  "player_ai_tec_taunt.9": "Yirmi yıllık kriz yönetimi bana israfı görür görmez tanımayı öğretti. Şu an filo yapına bakıyorum.",
  "player_ai_tec_taunt.10": "Kaynakları sonsuz stokun varmış gibi harcıyorsun. Ufak bir düzeltme: yok.",
  "player_ai_tec_loyalist_taunt.1": "Filonun enkazı gökyüzümüzde yanarken halkım bu ışık gösterisini çok beğenecek.",
  "player_ai_tec_loyalist_taunt.2": "İmparatorluğunda kuşatma filosu diye buna mı geçiyor? Ne yazık.",
  "player_ai_tec_loyalist_taunt.3": "Filona baktığımda gördüğüm tek şey, topraklarımı tıkamayı bekleyen bir seyir tehlikesi daha.",
  "player_ai_tec_loyalist_taunt.4": "Halkın beyhudelik kavramını anlıyor mu? Savunma hattımla karşılaşınca anlayacaklar.",
  "player_ai_tec_loyalist_taunt.5": "Ve şimdi hava durumu: Çoğunlukla açık, yer yer ani enkaz alanı ihtimali var.",
  "player_ai_tec_loyalist_taunt.6": "Filondan bıktığın an, yıldız üssü komutanlarım onu senin için süs niyetine bir gezegen halkasına çevirmekten memnuniyet duyar.",
  "player_ai_tec_rebel_taunt.1": "Sapkın, Kseno ya da Hain. Fark etmez; hepsi aynı şekilde geberir.",
  "player_ai_tec_rebel_taunt.2": "Üstünlük'e karşı gelmeye cüret ettiğin an var olma hakkını kaybettin.",
  "player_ai_tec_rebel_taunt.3": "Filona iyi bak. Ona son bakışın olabilir.",
  "player_ai_tec_rebel_taunt.4": "Bilim insanlarım en yeni silahlarını denemek için sabırsızlanıyor... Ama senin filon ancak kontrol grubu olmaya layık.",
  "player_ai_tec_rebel_taunt.5": "Seni ve halkını galaksiden silmek için hiçbir bedel fazla değil. Gemiler, istasyonlar, gezegenler; hepsi yanacak.",
  "player_ai_tec_rebel_taunt.6": "Saklanacak yer yok. Kaçacak yer yok. Bu kavgayı sen başlattın ama ben bitireceğim.",
  "player_ai_vasari_taunt.1": "Ardımızda çöken imparatorluklar gördüm. Seninki bir dipnotu bile hak etmeyecek.",
  "player_ai_vasari_taunt.2": "Halkım nesillerdir yok oluştan sağ çıkıyor. Seninki bir sonraki atlamadan sağ çıkamayacak.",
  "player_ai_vasari_taunt.3": "Senin tam kadro muharebe grubundan daha dişli, yarı ölü gemilerdeki iskelet mürettebatlara komuta ettim.",
  "player_ai_vasari_taunt.4": "Yüzyıllardır imkânsız ihtimallere uyum sağlayıp hayatta kaldık. Sen sıradan bir çatışmaya uyum sağlayamıyor musun?",
  "player_ai_vasari_taunt.5": "Halkımın savaş hakkında unuttukları, senin medeniyetinin öğrendiklerinden fazla. Bunu bir hatırlatma say.",
  "player_ai_vasari_taunt.6": "Nesiller boyu süren savaş bize verimliliği öğretti. Sen de biraz öğrenmeyi düşünmelisin.",
  "player_ai_vasari_taunt.7": "Her atlama sonuncumuz olabilir. Biz de öyle savaşırız. Sen hep bir yarın varmış gibi savaşıyorsun.",
  "player_ai_vasari_taunt.8": "Ardımızda kararan koca yıldız sistemleri izledim. Senin ufak pusun titrek bir kıvılcım bile sayılmaz.",
  "player_ai_vasari_taunt.9": "Düşman, senin kaynak tükettiğin gibi dünyaları tüketiyor. Tek fark, onlar bu işte gerçekten iyi.",
  "player_ai_vasari_taunt.10": "Nesillerdir yok oluşun ta kendisinden kaçıyoruz. Seninle savaşmak mı? Neredeyse kara izni.",
  "player_ai_vasari_loyalist_taunt.1": "Filo dediğin şu hurda yığını, toplama zahmetine bile değmez.",
  "player_ai_vasari_loyalist_taunt.2": "Filomu mevziye sokmak, seni yok etmekten daha çok vaktimi alacak.",
  "player_ai_vasari_loyalist_taunt.3": "Gemilerini bana getir; onları oluşturan atomlar yolculuğun yakıtı olacak.",
  "player_ai_vasari_rebel_taunt.1": "Neredeyse her varlığın kurtarılmaya değer olduğunu düşünüyordum; insanlar bile. Sonra seninle tanıştım.",
  "player_ai_vasari_rebel_taunt.2": "Neden doğal düzene karşı savaşıyorsun? Bana hizmet et, yaşa. Direnirsen ölürsün.",
  "player_ai_vasari_rebel_taunt.3": "Hiyerarşideki yerini unutmuşa benziyorsun. Sana hatırlatacağım.",
  "player_ai_tec_alliance.1": "Birbirimizle savaşmasak da ikimizin yeterince derdi var. Şu anlaşmayı iki taraf için de kârlı hale getirelim.",
  "player_ai_tec_alliance.2": "Bir ittifak öneriyorum. Senin sistemlerin, benim ticaret yollarım; bu anlaşmadan ikimiz de kârlı çıkarız.",
  "player_ai_tec_alliance.3": "Rakamlar yalan söylemez. Birlikte, ayrı olduğumuzdan daha güçlüyüz. Ne dersin?",
  "player_ai_vasari_alliance.1": "İkimizden de büyük tehditler var. Onlarla birlikte yüzleşmemizi öneriyorum.",
  "player_ai_vasari_alliance.2": "Sana ittifak teklif ediyorum. Buralarda ikimizden de beter şeyler var. Bu konuda bana güven.",
  "player_ai_vasari_alliance.3": "Hayatta kalmak iş birliğini sever. Ya yanımda dur ya da asıl tehdit geldiğinde kenara süpürül.",
  "player_ai_tec_enclave_bounty_taunt.0": "Sistemin portföy dengelemesi için işaretlendi. Üçüncü taraf çözümler devreye alındı.",
  "player_ai_tec_enclave_bounty_taunt.1": "Fayda-maliyet analizini yaptık. İbretlik bir hikâye olarak daha değerlisin.",
  "player_ai_tec_enclave_bounty_taunt.2": "{} için bir sözleşme açtık. Bunu bir piyasa düzeltmesi say.",
  "player_ai_tec_enclave_bounty_taunt.3": "Bunu bölgesel istikrara yapılmış bir yatırım say. Getirisi umut verici görünüyor.",
  "player_ai_tec_enclave_bounty_taunt.4": "{}, yüksek değerli bir fırsat olarak işaretlendi. Senin dışında herkes için.",
  "player_ai_tec_enclave_bounty_taunt.5": "Filolarımızı büyüme sektörlerine ayırmayı tercih ediyoruz. Ortadan kaldırılman da buna uygun olarak dış kaynağa verildi.",
  "player_ai_tec_enclave_bounty_taunt.7": "{} koordinatları artık ilgili taraflara açık. Rekabetçi bir fiyatla.",
  "player_ai_tec_enclave_bounty_taunt.9": "Kişisel bir mesele değil. Elenmen sadece sağlam bir mali politika.",
  "player_ai_tec_enclave_bounty_taunt.10": "{} için fırsat maliyeti güncellendi. Pozisyonunu gözden geçirmeni öneririm.",
  "player_ai_tec_primacy_bounty_taunt.0": "{} başına ödül koyduk. Bakalım gerçekten kaç dostun varmış.",
  "player_ai_tec_primacy_bounty_taunt.1": "Kredi konuşur. Şu anda senin adını söylüyor. Hem de epey yüksek sesle.",
  "player_ai_tec_primacy_bounty_taunt.3": "Bu işi kendimiz de halledebilirdik. Ama bu zevki neden tekelimize alalım?",
  "player_ai_tec_primacy_bounty_taunt.4": "{} adını meşhur ettik. Rica ederiz.",
  "player_ai_tec_primacy_bounty_taunt.5": "Sektördeki her namlu az önce yeni bir rota buldu.",
  "player_ai_tec_primacy_bounty_taunt.6": "Artık kellene bir ödül kondu. Kalan atlamalarını akıllıca harca.",
