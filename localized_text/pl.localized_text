  "dlc2_advent_loyalist_super_capital_ship_loot_name": "Wrak Oblivii",
  "dlc2_advent_loyalist_super_capital_ship_name": "Drednot Oblivia",
  "dlc2_advent_loyalist_super_kinetic_blast_ability_description": "Wystrzeliwuje niszczący ładunek energii telekinetycznej w jednostkę wroga za pomocą lancy psikinetycznej Oblivii.\\n\\nKażdy cel zdolny do ruchu zostaje też gwałtownie odrzucony od drednota Oblivia.",
  "dlc2_advent_loyalist_super_kinetic_blast_ability_name": "Psikinetyczny wybuch",
  "dlc2_advent_loyalist_super_stasis_beam_ability_description": "Użyj lancy psikinetycznej, by wytworzyć telekinetyczne pola utrzymujące wokół celu, unieruchomić go i przy okazji osłabić jego obronę.",
  "dlc2_advent_loyalist_super_stasis_beam_ability_name": "Promień stazy",
  "dlc2_advent_loyalist_super_subsume_energy_ability_description": "Psionicznie wypacza pola zawierające rdzeń plazmowy Oblivii, otaczając nimi statki wroga i natychmiast przenosząc małą ilość antymaterii z powrotem do Oblivii, pozostawiając broń energetyczną rozładowaną.",
  "dlc2_advent_loyalist_super_subsume_energy_ability_name": "Wchłonij energię",
  "dlc2_advent_loyalist_super_volatile_plasma_ability_description": "Wzmacnia broń plazmową Oblivii dodatkowym niestabilnym materiałem prosto z reaktora, dając szansę na zadawanie obrażeń w czasie przy trafieniu jednostek wroga. \\n\\nTen proces destabilizuje reaktor plazmowy do tego stopnia, że Oblivia wyemituje niszczącą falę, jeśli zostanie zniszczona.",
  "dlc2_advent_loyalist_super_volatile_plasma_ability_name": "Niestabilna plazma",
  "dlc2_advent_loyalist_super_volatile_plasma_on_death": "Efekt po zniszczeniu Oblivii:",
  "dlc2_advent_loyalist_super_volatile_plasma_on_hit": "Przy trafieniu plazmą:",
  "dlc2_advent_rebel_super_capital_ship_description": "Wszechstronny okręt wojenny, który czerpie siłę ze strat przyjaznych jednostek.",
  "dlc2_advent_rebel_super_capital_ship_loot_name": "Wrak Justicii",
  "dlc2_advent_rebel_super_capital_ship_malefic_locus_unit_item_description": "Złowrogi wzmacniacz PsiTech, który zwiększa potencjał zadawania obrażeń zdolnościami używanymi przez Justicję.",
  "dlc2_advent_rebel_super_capital_ship_malefic_locus_unit_item_name": "Złowrogie ognisko",
  "dlc2_advent_rebel_super_capital_ship_mind_locus_unit_item_description": "Tajemniczy wzmacniacz PsiTech, który zwiększa potencjał wsparcia zdolności używanych przez Justicję.",
  "dlc2_advent_rebel_super_capital_ship_mind_locus_unit_item_name": "Ognisko umysłu",
  "dlc2_advent_rebel_super_capital_ship_name": "Drednot Justicia",
  "dlc2_advent_rebel_super_capital_ship_savior_locus_unit_item_description": "Niezłomny wzmacniacz PsiTech, który zwiększa obronny potencjał zdolności używanych przez Justicję.",
  "dlc2_advent_rebel_super_capital_ship_savior_locus_unit_item_name": "Ognisko zbawiciela",
  "dlc2_advent_rebel_super_flare_ability_description": "Justicia ładuje się, by uwolnić zgromadzoną energię w niszczycielskiej fali. Podczas ładowania zadaje lekkie obrażenia pobliskim wrogom, po czym zużywa całą antymaterię w jednej katastrofalnej eksplozji. \\n\\nTo zdolność podtrzymywana — można ją zakończyć wcześniej, wydając temu statkowi polecenie Stop.",
