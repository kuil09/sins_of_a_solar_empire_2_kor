  "planet_bonus.meteorite_craters.name": "Sık Meteor Yağmurları",
  "planet_bonus.neutron_magnetic_flux.desc": "Nötron Yıldızı'nın canavarca güçlü ve hızla dönen manyetik alanları, yörüngedeki gemilerin kalkanlarını söküyor ve yetenek kullanımını engelliyor.",
  "planet_bonus.neutron_magnetic_flux.name": "Nötron Manyetik Akısı",
  "planet_bonus.oceanic_energy_converter.desc": "Su altı araştırmaları, okyanus dalgalarını enerjiye çevirip ticareti canlandıran bir sistem ortaya çıkardı.",
  "planet_bonus.oceanic_energy_converter.name": "Okyanus Enerji Dönüştürücüsü",
  "planet_bonus.pirate_treasure.desc": "Haksız yollarla elde edilmiş devasa bir servet, her seferinde bir kargo ambarı dolusu olarak başkentine taşınıyor. Kredi gelirine bonus sağlar.",
  "planet_bonus.pirate_treasure.name": "Yağmalanmış Ganimet",
  "planet_bonus.plasma_storm.desc": "Tehlikeli plazma bulutları saldırı gemisi ve füze fırlatılmasını engelliyor, inşaat bölmelerini de kilitleyerek yeni gemilerin üretimini durduruyor.",
  "planet_bonus.plasma_storm.name": "Plazma Fırtınası",
  "planet_bonus.polluted_environment.desc": "Yüzey taramaları, bu dünyanın eski savaş silahlarından kaynaklanmış olabilecek ağır kirlilik altında olduğunu gösteriyor. Bu gezegen zor gelişir.",
  "planet_bonus.polluted_environment.name": "Kirli Çevre",
  "planet_bonus.quantum_comm_hub.desc": "Kuantum iletişim sistemi keşfedildi, bu dünyadaki araştırmaları hızlandırıyor.",
  "planet_bonus.quantum_comm_hub.name": "Kuantum İletişim Merkezi",
  "planet_bonus.radiation_storm.desc": "Yoğun radyasyon, pasif tamir ve yenilenme sistemlerinin kullanımını engelliyor.",
  "planet_bonus.radiation_storm.name": "Radyasyon Fırtınası",
  "planet_bonus.rusted_core.desc": "Bu dünyanın çekirdeği neredeyse tamamen çürümüş, çekim kuyusunu daraltmış ve çıkarılacak metal miktarını sınırlamış.",
  "planet_bonus.rusted_core.name": "Paslı Çekirdek",
  "planet_bonus.shattered_planet.desc": "Bu bölgedeki uzayı dolduran sıcak ve yüksek enerjili gezegen maddesi sensörleri bozuyor; silah menzilini, yetenek menzilini ve taret takibini büyük ölçüde azaltıyor.",
  "planet_bonus.shattered_planet.name": "Gezegen Kalıntıları",
  "planet_bonus.ship_factories.desc": "Bilinmeyen kökenli, aceleyle inşa edilmiş gemi limanları kilometrelerce uzanıyor. Onları onarmak, burada yeni gemiler inşa etme yeteneğini büyük ölçüde artırır.",
  "planet_bonus.ship_factories.name": "Verimli Gemi Tersaneleri",
  "planet_bonus.singularity_gravity_slingshot.desc": "Kara deliğin devasa çekim gücü, çekim kuyusundaki gemiler tarafından hızlarını artırmak için kullanılıyor.",
  "planet_bonus.singularity_gravity_slingshot.name": "Tekillik Çekim Sapanı",
  "planet_bonus.singularity_time_dilation.desc": "Kara deliğe yakın bölgede uzay-zaman bükülüyor, yakındaki gemilerde ciddi zaman genişlemesi oluyor.",
  "planet_bonus.singularity_time_dilation.name": "Tekillik Zaman Genişlemesi",
  "planet_bonus.solar_energy_reserves.desc": "İnce bir atmosfer ve güneşe yakınlık, güneş enerjisine kolay erişim sağlar, bu da gezegenin daha fazla yörünge yapısını desteklemesine olanak tanır.",
  "planet_bonus.solar_energy_reserves.name": "Güneş Enerjisi Hasadı",
  "planet_bonus.solar_gravity_slingshot.desc": "Yıldızın muazzam çekim gücü, çekim kuyusundaki gemiler tarafından hızlarını artırmak için kullanılıyor.",
  "planet_bonus.solar_gravity_slingshot.name": "Güneş Çekim Sapanı",
  "planet_bonus.solar_regeneration.desc": "Yoğun yıldız radyasyonu, antimadde yenilenme hızını büyük ölçüde artırır.",
  "planet_bonus.solar_regeneration.name": "Güneş Yenilenmesi",
